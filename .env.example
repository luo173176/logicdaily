# ---------------------------------------------------------------------------
# LogicDaily 环境变量模板
# 复制为 .env.local（本地）或在部署平台的环境变量里配置（生产）。
# 只有服务端读取的变量不要加 NEXT_PUBLIC_ 前缀；
# 也不要把任何密钥写进 next.config.ts 的 env 字段（那份配置会被打进浏览器包）。
# ---------------------------------------------------------------------------

# ===== AI 思维教练（可选，不配置时其余功能完全可用）=====
# OpenAI 兼容接口的密钥。留空 = AI 功能关闭。
AI_API_KEY=
# 模型服务基址，例如 https://api.openai.com/v1 或 https://api.deepseek.com/v1
AI_BASE_URL=
# 默认模型名
AI_MODEL=gpt-4o-mini

# 允许被使用的模型服务地址（逗号分隔）。默认只允许上面 AI_BASE_URL 一个。
# 只有列在这里的地址才会被服务端接受，用于阻断 SSRF 与费用滥用。
AI_ALLOWED_BASE_URLS=
# 是否允许客户端在允许列表内自行指定 baseUrl（默认 false，推荐保持 false）
AI_ALLOW_CLIENT_BASE_URL=false
# 仅本地开发：允许 http 与 127.0.0.1（例如本机 Ollama）。生产环境必须为 false
AI_ALLOW_LOOPBACK=false

# 成本控制与保护
AI_MAX_INPUT_CHARS=12000
AI_MAX_OUTPUT_TOKENS=900
AI_TIMEOUT_MS=25000
AI_DAILY_LIMIT=60
AI_RATE_LIMIT_PER_MIN=12
AI_RETRY_LIMIT=2

# ===== 云端账户与同步（Phase 3，尚未在应用内启用）=====
# 见 docs/ARCHITECTURE.md 的“云端模式”一节与 supabase/migrations 下的 SQL。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ===== 部署 =====
# 反向代理后，声明哪些请求头可以信任（逗号分隔，例如 x-forwarded-for 或 cf-connecting-ip）。
# 留空 = 不读任何转发头，所有请求共用一个限流配额桶。
# 只有当你的代理会覆写该头时才配置，否则客户端可以伪造它来打散限流。
TRUST_PROXY_HEADERS=
